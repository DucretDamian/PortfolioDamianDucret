---
interface Props {
  /**
   * 'svg': Ilustración minimalista integrada (gata gris con panza blanca)
   * '2d' : Imagen personalizada 2D (.png, .webp, .svg, .gif) desde /public/cat/
   * '3d' : Modelo 3D interactivo (.glb / .gltf) desde /public/cat/
   */
  mode?: 'svg' | '2d' | '3d';
  src?: string;
  name?: string;
}

const {
  mode = 'svg',
  src = '/cat/mi-gata.glb',
  name = 'Gata',
} = Astro.props;
---

<div
  id="cat-easter-egg"
  class="group relative inline-flex flex-col items-center cursor-pointer select-none outline-none focus:outline-none"
  role="button"
  tabindex="0"
  aria-label="Interactuar con la gata"
>
  <!-- Tooltip sutil al pasar el cursor (sin números) -->
  <div
    id="cat-tooltip"
    class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 w-max max-w-[230px] px-2.5 py-1 rounded-md bg-surface border border-border shadow-sm opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-30 text-center"
  >
    <p class="text-[10px] text-primary font-mono">
      <span id="cat-status-text">Observando el escritorio</span>
    </p>
  </div>

  <!-- Onomatopeya ambiental o al hacer clic ("prrr..." de día / "z z z..." de noche) -->
  <span
    id="cat-ambient-pop"
    class="pointer-events-none absolute top-1 right-1 font-mono text-[11px] text-muted opacity-0 z-30"
  >
    prrr...
  </span>

  <!-- MODO 1: Ilustración minimalista SVG con transición natural Día (Sentada) ↔ Noche (Acostada) -->
  {
    mode === 'svg' && (
      <svg
        id="cat-svg"
        viewBox="0 0 120 115"
        class="w-24 h-24 sm:w-28 sm:h-28 drop-shadow-sm"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Sombra compartida sobre la mesa -->
        <ellipse
          cx="62"
          cy="106"
          rx="36"
          ry="5"
          class="fill-black/10 dark:fill-black/35 transition-all duration-500"
        />

        <!-- ========================================================= -->
        <!-- POSTURA DÍA (MODO CLARO): Sentada, sigue el mouse, parpadea -->
        <!-- ========================================================= -->
        <g class="cat-pose-awake">
          <!-- Cola gris con punta blanca (animada suavemente) -->
          <g class="animate-tail">
            <path
              d="M40 96 C20 96, 14 78, 22 66"
              stroke="#6E737B"
              stroke-width="8"
              stroke-linecap="round"
            />
            <path
              d="M19 71 C19 68, 20 67, 22 66"
              stroke="#F7F5F0"
              stroke-width="8"
              stroke-linecap="round"
            />
          </g>

          <!-- Cuerpo exterior (Gris suave minimalista) -->
          <path
            d="M38 62 C34 78, 36 102, 46 104 L78 104 C88 102, 90 78, 86 62 C82 50, 42 50, 38 62 Z"
            fill="#6E737B"
          />

          <!-- Panza y pecho blanco característico -->
          <path
            d="M47 64 C44 76, 46 99, 53 103 L71 103 C78 99, 80 76, 77 64 C74 55, 50 55, 47 64 Z"
            fill="#F7F5F0"
          />

          <!-- Patitas delanteras blancas (botitas) -->
          <ellipse cx="52" cy="103" rx="6" ry="3.5" fill="#F7F5F0" stroke="#5B6068" stroke-width="1" />
          <ellipse cx="72" cy="103" rx="6" ry="3.5" fill="#F7F5F0" stroke="#5B6068" stroke-width="1" />

          <!-- Oreja izquierda -->
          <g>
            <path d="M41 42 L37 22 L53 32 Z" fill="#6E737B" stroke="#5B6068" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M42 39 L40 27 L50 33 Z" fill="#D8B4B0" />
          </g>

          <!-- Oreja derecha (con movimiento sutil ocasional) -->
          <g class="animate-ear">
            <path d="M83 42 L87 22 L71 32 Z" fill="#6E737B" stroke="#5B6068" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M82 39 L84 27 L74 33 Z" fill="#D8B4B0" />
          </g>

          <!-- Rostro principal gris -->
          <ellipse cx="62" cy="45" rx="23" ry="18" fill="#6E737B" />

          <!-- Manchita blanca sutil en el hocico/mentón -->
          <path d="M54 50 Q62 43 70 50 Q73 60 62 61 Q51 60 54 50 Z" fill="#F7F5F0" />

          <!-- Ojos abiertos (siguen el cursor en modo día) -->
          <g id="cat-eyes-open">
            <g id="cat-pupil-left" class="transition-transform duration-75 ease-out">
              <circle cx="53" cy="43" r="3.1" fill="#232220" />
              <circle cx="54" cy="41.8" r="1" fill="#FAF8F5" />
            </g>
            <g id="cat-pupil-right" class="transition-transform duration-75 ease-out">
              <circle cx="71" cy="43" r="3.1" fill="#232220" />
              <circle cx="72" cy="41.8" r="1" fill="#FAF8F5" />
            </g>
          </g>

          <!-- Ojos cerrados / felices (para parpadeo ocasional y clic) -->
          <g id="cat-eyes-happy" class="hidden">
            <path d="M49 43 Q53 39.5 57 43" stroke="#232220" stroke-width="2" stroke-linecap="round" fill="none" />
            <path d="M67 43 Q71 39.5 75 43" stroke="#232220" stroke-width="2" stroke-linecap="round" fill="none" />
          </g>

          <!-- Nariz y boca minimalista -->
          <polygon points="60,48 64,48 62,50.5" fill="#C99692" />
          <path d="M62 50.5 Q59 53.5 56 52 M62 50.5 Q65 53.5 68 52" stroke="#5B6068" stroke-width="1.3" stroke-linecap="round" fill="none" />

          <!-- Bigotes finos -->
          <line x1="34" y1="47" x2="45" y2="48" stroke="#9CA0A6" stroke-width="1" stroke-linecap="round" />
          <line x1="35" y1="51" x2="45" y2="51" stroke="#9CA0A6" stroke-width="1" stroke-linecap="round" />
          <line x1="90" y1="47" x2="79" y2="48" stroke="#9CA0A6" stroke-width="1" stroke-linecap="round" />
          <line x1="89" y1="51" x2="79" y2="51" stroke="#9CA0A6" stroke-width="1" stroke-linecap="round" />
        </g>

        <!-- ========================================================= -->
        <!-- POSTURA NOCHE (MODO OSCURO): Acostada durmiendo, "zzz..." -->
        <!-- ========================================================= -->
        <g class="cat-pose-asleep">
          <!-- Cuerpo acostado hecho un bollito con respiración suave -->
          <g class="animate-sleep-breathe">
            <!-- Lomo gris acostado -->
            <path
              d="M22 92 C22 72, 46 68, 66 74 C80 78, 86 92, 82 103 L28 103 C23 102, 22 97, 22 92 Z"
              fill="#6E737B"
            />
            <!-- Panza blanca visible al costado mientras duerme -->
            <path
              d="M34 94 C36 83, 56 83, 64 94 L64 103 L34 103 Z"
              fill="#F7F5F0"
            />
          </g>

          <!-- Cola enroscada descansando en la mesa con punta blanca -->
          <path
            d="M25 98 C14 98, 12 88, 22 86"
            stroke="#6E737B"
            stroke-width="7"
            stroke-linecap="round"
          />
          <path
            d="M20 86.5 C21 86, 23 86, 24 86.5"
            stroke="#F7F5F0"
            stroke-width="7"
            stroke-linecap="round"
          />

          <!-- Patitas blancas apoyadas adelante -->
          <ellipse cx="58" cy="103" rx="6" ry="3.2" fill="#F7F5F0" stroke="#5B6068" stroke-width="1" />
          <ellipse cx="78" cy="103" rx="6" ry="3.2" fill="#F7F5F0" stroke="#5B6068" stroke-width="1" />

          <!-- Cabeza apoyada durmiendo (a la derecha del cuerpo) -->
          <g id="cat-sleep-head">
            <!-- Oreja izquierda -->
            <path d="M56 76 L52 59 L66 67 Z" fill="#6E737B" stroke="#5B6068" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M57 74 L54 63 L64 68 Z" fill="#D8B4B0" />

            <!-- Oreja derecha (se mueve sutilmente entre sueños o al acariciar) -->
            <g id="cat-sleep-ear" class="animate-ear-sleep">
              <path d="M90 76 L94 59 L80 67 Z" fill="#6E737B" stroke="#5B6068" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M89 74 L92 63 L82 68 Z" fill="#D8B4B0" />
            </g>

            <!-- Rostro apoyado -->
            <ellipse cx="73" cy="83" rx="20" ry="15" fill="#6E737B" />

            <!-- Hocico/mentón blanco -->
            <path d="M66 87 Q73 81 80 87 Q82 95 73 96 Q64 95 66 87 Z" fill="#F7F5F0" />

            <!-- Ojos cerrados durmiendo (curva hacia abajo relajada) -->
            <path d="M61 81 Q65 84.5 69 81" stroke="#232220" stroke-width="1.8" stroke-linecap="round" fill="none" />
            <path d="M77 81 Q81 84.5 85 81" stroke="#232220" stroke-width="1.8" stroke-linecap="round" fill="none" />

            <!-- Nariz rosada y boquita dormida -->
            <polygon points="71.5,85.5 74.5,85.5 73,87.5" fill="#C99692" />
            <path d="M73 87.5 Q70.5 90 68 89 M73 87.5 Q75.5 90 78 89" stroke="#5B6068" stroke-width="1.2" stroke-linecap="round" fill="none" />

            <!-- Bigotes relajados -->
            <line x1="49" y1="85" x2="58" y2="85.5" stroke="#9CA0A6" stroke-width="1" stroke-linecap="round" />
            <line x1="50" y1="88.5" x2="58" y2="88" stroke="#9CA0A6" stroke-width="1" stroke-linecap="round" />
            <line x1="97" y1="85" x2="88" y2="85.5" stroke="#9CA0A6" stroke-width="1" stroke-linecap="round" />
            <line x1="96" y1="88.5" x2="88" y2="88" stroke="#9CA0A6" stroke-width="1" stroke-linecap="round" />
          </g>
        </g>
      </svg>
    )
  }

  <!-- MODO 2: Imagen / Sprite 2D Personalizado -->
  {
    mode === '2d' && (
      <img
        src={src}
        alt={name}
        class="w-24 h-24 sm:w-28 sm:h-28 object-contain drop-shadow-sm transition-transform duration-300 group-hover:-translate-y-0.5"
      />
    )
  }

  <!-- MODO 3: Modelo 3D Interactivo (.glb / .gltf) -->
  {
    mode === '3d' && (
      <div class="w-28 h-28 sm:w-32 sm:h-32">
        <script
          type="module"
          src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"
        />
        <model-viewer
          src={src}
          alt={name}
          autoplay
          camera-controls
          disable-zoom
          shadow-intensity="0.6"
          style="width: 100%; height: 100%; background-color: transparent;"
        />
      </div>
    )
  }
</div>

<script>
  const catWidget = document.getElementById('cat-easter-egg');
  const catSvg = document.getElementById('cat-svg');
  const petCountEl = document.getElementById('cat-pet-count');
  const statusTextEl = document.getElementById('cat-status-text');
  const ambientPopEl = document.getElementById('cat-ambient-pop');
  const eyesOpen = document.getElementById('cat-eyes-open');
  const eyesHappy = document.getElementById('cat-eyes-happy');
  const pupilLeft = document.getElementById('cat-pupil-left');
  const pupilRight = document.getElementById('cat-pupil-right');
  const sleepHead = document.getElementById('cat-sleep-head');

  const dayPhrases = [
    'Ronroneando...',
    'Siguiendo tu cursor',
    'Amasando la mesa',
    'Atenta al código',
  ];

  const nightPhrases = [
    'Durmiendo profundamente...',
    'Soñando con atún...',
    'Movió una orejita entre sueños',
    'Durmiendo al calor del velador',
  ];

  let count = Number(localStorage.getItem('cat-pets') || 0);
  if (petCountEl) petCountEl.textContent = String(count);

  function isDarkMode() {
    return document.documentElement.classList.contains('dark');
  }

  function showFloatingText(text: string) {
    if (!ambientPopEl) return;
    ambientPopEl.textContent = text;
    ambientPopEl.classList.remove('animate-ambient-float');
    // Forzar reflow para reiniciar animación
    void ambientPopEl.offsetWidth;
    ambientPopEl.classList.add('animate-ambient-float');
  }

  // 1. Seguimiento de mirada al cursor (solo cuando está despierta en modo día)
  window.addEventListener('mousemove', (e) => {
    if (isDarkMode() || !catSvg || !pupilLeft || !pupilRight) return;

    const rect = catSvg.getBoundingClientRect();
    const catCenterX = rect.left + rect.width / 2;
    const catCenterY = rect.top + rect.height * 0.38;

    const dx = e.clientX - catCenterX;
    const dy = e.clientY - catCenterY;
    const angle = Math.atan2(dy, dx);
    const maxOffset = 2.2;
    const dist = Math.min(Math.hypot(dx, dy) / 90, 1) * maxOffset;

    const moveX = (Math.cos(angle) * dist).toFixed(2);
    const moveY = (Math.sin(angle) * dist).toFixed(2);

    pupilLeft.style.transform = `translate(${moveX}px, ${moveY}px)`;
    pupilRight.style.transform = `translate(${moveX}px, ${moveY}px)`;
  });

  // 2. Parpadeo ocasional en modo día + "prrr..." / "zzz..." ambiental cada unos segundos
  setInterval(() => {
    if (!isDarkMode()) {
      // Parpadeo corto natural
      eyesOpen?.classList.add('hidden');
      eyesHappy?.classList.remove('hidden');
      setTimeout(() => {
        eyesOpen?.classList.remove('hidden');
        eyesHappy?.classList.add('hidden');
      }, 180);
    }
  }, 4600);

  setInterval(() => {
    if (isDarkMode()) {
      showFloatingText('z z z...');
      if (statusTextEl && !catWidget?.matches(':hover')) {
        statusTextEl.textContent = 'Durmiendo bajo el velador';
      }
    } else {
      showFloatingText('prrr...');
      if (statusTextEl && !catWidget?.matches(':hover')) {
        statusTextEl.textContent = 'Observando el escritorio';
      }
    }
  }, 5800);

  // 3. Interacción al hacer clic (diferente si está despierta o durmiendo)
  function petCat() {
    count += 1;
    localStorage.setItem('cat-pets', String(count));
    if (petCountEl) petCountEl.textContent = String(count);

    if (isDarkMode()) {
      // Modo Noche: reacción muy sutil porque está durmiendo
      if (statusTextEl) {
        statusTextEl.textContent = nightPhrases[count % nightPhrases.length];
      }
      showFloatingText('mrrp... zzz');
      if (sleepHead) {
        sleepHead.style.transition = 'transform 0.25s ease';
        sleepHead.style.transform = 'translateY(-1px) rotate(-1.5deg)';
        setTimeout(() => {
          sleepHead.style.transform = 'translateY(0) rotate(0deg)';
        }, 350);
      }
    } else {
      // Modo Día: cierra los ojos contenta y ronronea
      if (statusTextEl) {
        statusTextEl.textContent = dayPhrases[count % dayPhrases.length];
      }
      showFloatingText('prrr...');
      eyesOpen?.classList.add('hidden');
      eyesHappy?.classList.remove('hidden');

      setTimeout(() => {
        eyesOpen?.classList.remove('hidden');
        eyesHappy?.classList.add('hidden');
      }, 850);
    }
  }

  catWidget?.addEventListener('click', petCat);
  catWidget?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      petCat();
    }
  });
</script>
